{
  // Live-reloading dev servers. `dev` is the default build task, so Cmd/Ctrl+Shift+B
  // starts the API and Vite together, one terminal each.
  //
  // The API needs `--reload` because uvicorn does not watch by default; the `--reload-dir`
  // flags keep the watcher off `.cache/`, which every run writes to - watching it would
  // restart the server on each generated book and kill the request writing it. Vite
  // already hot-replaces a changed module, so its task is only `npm run dev`.
  //
  // The second pair is for a copy running alongside someone else's. It needs all three
  // ports to agree: VITE_PORT is where Vite serves, FRONTEND_PORT is the origin the API
  // allows, and VITE_API_BASE is the API this Vite calls. Set one and not the others and
  // the browser blocks the request.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "dependsOn": ["API: dev", "Vite: dev"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "dev (second instance)",
      "dependsOn": ["API: dev (8100)", "Vite: dev (5273)"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "API: dev",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python -m uvicorn backend.api.main:get_app --factory --reload --reload-dir backend --reload-dir context --port 8000",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "API_PORT": "8000", "FRONTEND_PORT": "5173" }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "dev", "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "Vite: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "dev", "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "API: dev (8100)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python -m uvicorn backend.api.main:get_app --factory --reload --reload-dir backend --reload-dir context --port 8100",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "API_PORT": "8100", "FRONTEND_PORT": "5273" }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "dev2", "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "Vite: dev (5273)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend",
        "env": { "VITE_PORT": "5273", "VITE_API_BASE": "http://localhost:8100" }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "dev2", "panel": "dedicated", "reveal": "always" }
    }
  ]
}
